# === SERVER ===
PORT=5000
NODE_ENV=development

# === DATABASE ===
MONGO_URI=mongodb://localhost:27017/trendverse

# === JWT ===
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=2h

# === SMTP (Brevo / Sendinblue) ===
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_key_here

# === FRONTEND ===
CLIENT_URL=http://localhost:3000

# === AI ===
AI_API_KEY=your_ai_key_here

# === CACHE ===
CACHE_TTL=60
